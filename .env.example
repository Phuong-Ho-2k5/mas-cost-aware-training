# Copy this file to .env and fill in your own OpenRouter API key.
# The CLI loads project-root .env; existing process variables take precedence.
# Model selection is configured with model_id in the YAML config.
OPENROUTER_API_KEY=

# Local vLLM (analysis_mode: local in the YAML config).
LLM_BASE_URL=http://127.0.0.1:8000/v1
# Optional for a server started with an API key; never committed.
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120
LLM_DEADLINE_SECONDS=130
LLM_MAX_OUTPUT_TOKENS=1024
