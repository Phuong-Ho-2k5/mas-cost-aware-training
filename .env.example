# Copy to .env. Keep real keys, private endpoints and machine paths in .env only.
# CLI loads project-root .env; existing process variables take precedence.
# Use analysis_mode: vllm and model_id: Qwen/Qwen3.5-0.8B in YAML.
# Setup/start/stop: scripts/setup_vllm.ps1, start_vllm.ps1, stop_vllm.ps1.

# vLLM endpoint and qualified runtime identity.
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_RUNTIME_MANIFEST=tmp/vllm/runtime-manifest.json
# Optional credential when the vLLM endpoint requires authentication.
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120
LLM_DEADLINE_SECONDS=130
LLM_MAX_OUTPUT_TOKENS=1024

# Optional Hugging Face credential for private/gated models; public Qwen needs none.
HF_TOKEN=
