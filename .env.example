# Copy to .env. Keep real keys, private endpoints and machine paths in .env only.
# CLI and setup/start_local_llm.ps1 load project-root .env.
# Existing process variables take precedence; launcher arguments override defaults.
# Model selection is configured with model_id in the YAML config.
# Required only for analysis_mode: openrouter.
OPENROUTER_API_KEY=

# OpenAI-compatible endpoint (analysis_mode: local).
LLM_BASE_URL=http://127.0.0.1:8000/v1
# Optional credential for an external endpoint requiring authentication.
# The bundled loopback Qwen server does not require or enforce this key.
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120
LLM_DEADLINE_SECONDS=130
LLM_MAX_OUTPUT_TOKENS=1024

# Optional Hugging Face credential for private/gated models; public Qwen needs none.
HF_TOKEN=

# Local Qwen launcher. Empty cache path defaults to <project>/tmp/model-cache.
# Put your own absolute cache path in .env, not in tracked scripts.
LOCAL_LLM_MODEL_CACHE=
LOCAL_LLM_DEVICE=cuda
LOCAL_LLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct
LOCAL_LLM_REVISION=7ae557604adf67be50417f59c2c2f167def9a775
# Optional Hugging Face home override; otherwise <model-cache>/huggingface.
HF_HOME=
